# Smart Salary Planner Environment Variables Example

# Environment Mode
ENVIRONMENT=development

# Gemini AI API Key (Stored securely on backend)
GEMINI_API_KEY=your_gemini_api_key_here

# Firebase Admin SDK & Project Config
FIREBASE_PROJECT_ID=smart-salary-planner
FIREBASE_CREDENTIALS_PATH=path/to/firebase-credentials.json

# Frontend Environment Variables (Vite)
VITE_API_URL=http://localhost:8000/api
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=smart-salary-planner.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=smart-salary-planner
VITE_FIREBASE_STORAGE_BUCKET=smart-salary-planner.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=1234567890
VITE_FIREBASE_APP_ID=1:1234567890:web:1234567890
